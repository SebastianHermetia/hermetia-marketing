{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "hermetiastart.digital-expert.de"
        }
      ],
      "destination": "https://astrakey.me/$1",
      "permanent": true
    },
    {
      "source": "/(\\w{2})/ueber-hermetia(.*)",
      "destination": "/$1/ueber-astrakey/",
      "permanent": true
    },
    {
      "source": "/(\\w{2})/vergleiche/tageshoroskop-vs-hermetia(.*)",
      "destination": "/$1/vergleiche/tageshoroskop-vs-astrakey/",
      "permanent": true
    },
    {
      "source": "/(\\w{2})/vergleiche/kostenloses-horoskop-vs-hermetia(.*)",
      "destination": "/$1/vergleiche/kostenloses-horoskop-vs-astrakey/",
      "permanent": true
    },
    {
      "source": "/(\\w{2})/wissen/warum-hermetia-keine-therapie-ist(.*)",
      "destination": "/$1/wissen/warum-astrakey-keine-therapie-ist/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/ingest/static/(.*)",
      "destination": "https://eu-assets.i.posthog.com/static/$1"
    },
    {
      "source": "/ingest/(.*)",
      "destination": "https://eu.i.posthog.com/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
